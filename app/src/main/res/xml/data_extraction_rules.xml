<?xml version="1.0" encoding="utf-8"?>
<!--
  Nenhum dado sai do device. Backup em nuvem e transferência device-to-device
  ficam DESABILITADOS: os dados são texto sensível criptografado localmente.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
